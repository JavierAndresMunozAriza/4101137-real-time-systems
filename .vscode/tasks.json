{
  "version": "2.0.0",
  "options": {
    "shell": {
      "executable": "/bin/bash",
      "args": ["-i", "-c"]
    }
  },
  "tasks": [
    {
      "label": "1. Compilar para STM32 (Nucleo L476RG)",
      "type": "shell",
      "command": "source ~/zephyrproject/zephyr/zephyr-env.sh 2>/dev/null || true; west build -p auto -b nucleo_l476rg firmware/superloop",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "2. Flashear STM32 (Nucleo L476RG) (OpenOCD)",
      "type": "shell",
      "command": "source ~/zephyrproject/zephyr/zephyr-env.sh 2>/dev/null || true; west flash -r openocd",
      "problemMatcher": []
    },
    {
      "label": "3. Monitor Serial STM32 (Nucleo L476RG) (/dev/ttyACM0)",
      "type": "shell",
      "command": "tio /dev/ttyACM0 -b 115200",
      "problemMatcher": []
    },
    {
      "label": "4. Compilar para STM32 (Nucleo G474RE)",
      "type": "shell",
      "command": "source ~/zephyrproject/zephyr/zephyr-env.sh 2>/dev/null || true; west build -p auto -b nucleo_g474re firmware/superloop",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "5. Flashear STM32 (Nucleo G474RE) (OpenOCD)",
      "type": "shell",
      "command": "source ~/zephyrproject/zephyr/zephyr-env.sh 2>/dev/null || true; west flash -r openocd",
      "problemMatcher": []
    },
    {
      "label": "6. Monitor Serial STM32 (Nucleo G474RE) (/dev/ttyACM0)",
      "type": "shell",
      "command": "tio /dev/ttyACM0 -b 115200",
      "problemMatcher": []
    },
    {
      "label": "7. Compilar para ESP32-S3",
      "type": "shell",
      "command": "source ~/zephyrproject/zephyr/zephyr-env.sh 2>/dev/null || true; west build -p auto -b esp32s3_devkitm firmware/superloop",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "8. Flashear ESP32-S3 (esptool)",
      "type": "shell",
      "command": "source ~/zephyrproject/zephyr/zephyr-env.sh 2>/dev/null || true; west flash -r esptool",
      "problemMatcher": []
    },
    {
      "label": "9. Monitor Serial ESP32-S3 (/dev/ttyUSB0)",
      "type": "shell",
      "command": "tio /dev/ttyUSB0 -b 115200",
      "problemMatcher": []
    },
    {
      "label": "10. Compilar para ESP32-C6",
      "type": "shell",
      "command": "source ~/zephyrproject/zephyr/zephyr-env.sh 2>/dev/null || true; west build -p auto -b esp32c6_devkitc firmware/superloop",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "11. Flashear ESP32-C6 (esptool)",
      "type": "shell",
      "command": "source ~/zephyrproject/zephyr/zephyr-env.sh 2>/dev/null || true; west flash -r esptool",
      "problemMatcher": []
    },
    {
      "label": "12. Monitor Serial ESP32-C6 (/dev/ttyUSB0)",
      "type": "shell",
      "command": "tio /dev/ttyUSB0 -b 115200",
      "problemMatcher": []
    }
  ]
}