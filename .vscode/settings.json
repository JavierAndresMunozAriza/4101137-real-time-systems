{
    "cmake.sourceDirectory": "/home/xavi/4101137-real-time-systems/firmware/superloop"
}
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Build Superloop (Lab 02)",
      "type": "shell",
      "command": "west build -p auto -b nucleo_l476rg firmware/superloop",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "2. Flash Board (OpenOCD)",
      "type": "shell",
      "command": "west flash -r openocd",
      "problemMatcher": []
    },
    {
      "label": "3. Open Serial Console (tio)",
      "type": "shell",
      "command": "tio /dev/ttyACM0 -b 115200",
      "problemMatcher": []
    },
    {
      "label": "4. Build + Flash + Monitor (Full Pipeline)",
      "type": "shell",
      "command": "west build -p auto -b nucleo_l476rg firmware/superloop && west flash -r openocd && tio /dev/ttyACM0 -b 115200",
      "problemMatcher": ["$gcc"]
    }
  ]
}