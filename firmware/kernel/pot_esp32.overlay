/*
 * Real pressure input, opt-in:
 *   west build ... -- -DEXTRA_DTC_OVERLAY_FILE=pot.overlay
 *
 * Wire the pot wiper to ADC1 channel 1 (ESP32-C6: GPIO1 · ESP32-S3: GPIO2),
 * the ends to 3V3 and GND. Channel 0 is the joystick input the C0116-DK has on
 * board; on the ESP32 devkits tie its pin (C6 GPIO0 · S3 GPIO1) to 3V3.
 */

#include <zephyr/dt-bindings/adc/adc.h>

/ {
	zephyr,user {
		io-channels = <&adc0 0>, <&adc0 1>;
	};
};

&adc0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};
